[Unit]
Description=Sensors to MQTT Bridge (I2C, GPIO, serial, TCP bridge)
Documentation=https://github.com/askrejans/sensors-to-mqtt
After=network-online.target
Wants=network-online.target
StartLimitBurst=5
StartLimitIntervalSec=60

[Service]
Type=simple
User=sensors-to-mqtt
Group=sensors-to-mqtt

# --headless: log to the journal, no terminal dashboard
ExecStart=/usr/bin/sensors-to-mqtt --headless --config /etc/sensors-to-mqtt/settings.toml

# The service writes no state
WorkingDirectory=/tmp
UMask=0077

# Restart policy
Restart=always
RestartSec=10

# Resource limits
MemoryMax=256M
CPUQuota=50%

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictRealtime=true
RestrictNamespaces=true
RestrictSUIDSGID=true
LockPersonality=true

# Hardware device access for the service user.
# i2c     covers /dev/i2c-* (MPU-6500, BMP280, BME280, SHT31, BH1750, INA219, ADS1115)
# dialout covers /dev/ttyACM*, /dev/ttyUSB*, /dev/ttyS* (SDS011 and other serial sensors)
# gpio    covers /dev/gpiomem, /dev/gpiochip* (buttons and switches)
SupplementaryGroups=i2c dialout gpio

# Capabilities
CapabilityBoundingSet=
AmbientCapabilities=

# System call filtering
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @obsolete
SystemCallErrorNumber=EPERM

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=sensors-to-mqtt

# Environment variables (optional - can also use settings.toml)
# Environment="SENSORS_TO_MQTT_LOG_LEVEL=info"
# Environment="SENSORS_TO_MQTT_MQTT_HOST=mqtt.local"
# Environment="SENSORS_TO_MQTT_HTTP_BIND=0.0.0.0"

[Install]
WantedBy=multi-user.target
